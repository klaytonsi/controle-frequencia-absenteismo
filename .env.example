# EN: Example settings. Copy this file to .env and adjust if needed.
# PT: Configurações de exemplo. Copie este arquivo para .env e ajuste se precisar.

# EN: Seed used to generate the synthetic data (same seed = same data).
# PT: Semente usada para gerar os dados sintéticos (mesma semente = mesmos dados).
DATA_SEED=42

# EN: Number of synthetic employees to generate.
# PT: Número de funcionários sintéticos a gerar.
NUM_EMPLOYEES=200
